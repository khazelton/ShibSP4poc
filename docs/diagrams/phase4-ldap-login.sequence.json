  "cards": [
    { "dot": "violet", "title": "Agent credentials live in LDAP", "items": ["Every agent→hub call is HTTP basic over TLS, validated by the hub's LDAPCredentialValidator (uid=%s,ou=people,dc=localtest)", "agents.xml holds no secret; rotating the LDAP password + agent.pwd never restarts the hub", "Hub 0.0.3: presented username must equal the agent id (p:usernames not honoured by external validators)"] },
    { "dot": "cyan", "title": "Browser never reaches the hub", "items": ["Redirect URI is the agent's TokenConsumer handler /Shibboleth.sso/Validate", "Hub does code exchange, JWKS validation, UserInfo, claim transcoding (email→mail, name→displayName) and filtering", "App sees only X-Shib-* headers set by Apache; Jetty is reachable from the agent alone"] }
