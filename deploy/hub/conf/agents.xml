<?xml version="1.0" encoding="UTF-8"?>
<!--
PoC replacement for conf/sp/agents.xml (Phase 2).

One networked agent, authenticated with HTTP basic + source-address check.
  id                   agent's agentID (agent.ini [remoting] agentID); also the basic-auth
                       username because the credentials map key is null.
  allowedAddressRanges the agent container's fixed IP (compose.yaml).
  credentials          secret from the poc.agent.secret property, which hub/entrypoint.sh
                       writes into sp.properties from the AGENT_SECRET env var.
Decoupling demo (Scott's point): swap the null key for an explicit service-account
username, or list several under p:usernames, without changing the agentID.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:util="http://www.springframework.org/schema/util"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:c="http://www.springframework.org/schema/c"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd"
       default-init-method="initialize"
       default-destroy-method="destroy">

    <!-- ============ Agents and their Applications ============ -->

    <!--
    Phase 4: agent identity decoupled from its credentials.
      p:id        the agent's identity at the hub (logs, audit, Application lookup).
      p:usernames LDAP service accounts allowed to authenticate as this agent. The agent
                  presents one of them as agent.ini agentID; LDAP validates the password
                  (conf/global.xml shibboleth.sp.AgentValidators). Two accounts let a
                  credential rotate, or overlap, without touching this file or the hub.
    No secrets here. Needs hub nightly 0.0.3-32 or later: before that, external validators
    required the username to equal p:id (defect #4 in docs/dev-list-writeup.md).
    Phase 2 in-config form, for reference: p:credentials="#{ {null : '%{poc.agent.secret}'} }"
    -->
    <bean p:id="sp4-agent.localtest" parent="shibboleth.sp.Agent"
          p:usernames="#{ {'sa1-sp4-agent', 'sa2-sp4-agent'} }"
          p:authenticationMethod="basic"
          p:allowedAddressRanges="172.30.0.20/32" />

    <!-- ============ RelyingParty Overrides ============ -->

    <util:list id="shibboleth.sp.RelyingPartyOverrides">
    </util:list>

    <import resource="oidc-credentials.xml" />

</beans>
